      "boundElements": [],
      "updated": 1789082043103,
      "link": null,
      "locked": false,
      "text": "ForWard Proxy \nReVerse Proxy\nTransparent Proxy \nSideCar Proxy example-> Observilibilty , Metric. Collector  , Logger \n",
      "rawText": "ForWard Proxy \nReVerse Proxy\nTransparent Proxy \nSideCar Proxy example-> Observilibilty , Metric. Collector  , Logger \n",
