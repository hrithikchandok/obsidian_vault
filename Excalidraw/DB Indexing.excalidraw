		{
			"id": "AlrVpjRG",
			"type": "text",
			"x": 204.7480613026836,
			"y": -65.97098283667276,
			"width": 643.839599609375,
			"height": 775,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "a5",
			"roundness": null,
			"seed": 1776217538,
			"version": 846,
			"versionNonce": 704744834,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1789895483781,
			"locked": false,
			"text": "B+ tree Features \n    self balancing tree \n    root and intermediate nodes are just for routing \n    leaves nodes will contain the actual data page \n    all leaf nodes are connected \n    there will m-1 keys \n    Range Queries \nTc - > \n    Insert, search , deletion -> O(log n )\n    Range Query -> O(log n +k) -> logn to find the starting range \n    and then traverse horizontally to find the k element horiz as \n    all leaf nodes are connected through linked list . \n\n    \nHash Index -> when we need key value look ups \n\ngood for hash idnex \nSelect * from users where email =\"hrithikdel@gmail.com\"\n\ngood for bt tree bad for hash index \nSelect * from users where email LIKE \"*del@gmail.com\"\n\nHash Index search -> O(1)\n\nFull Text Index -> Postgerois \n    Inverte words-> Documents \n\n\n\n\n",
			"rawText": "B+ tree Features \n    self balancing tree \n    root and intermediate nodes are just for routing \n    leaves nodes will contain the actual data page \n    all leaf nodes are connected \n    there will m-1 keys \n    Range Queries \nTc - > \n    Insert, search , deletion -> O(log n )\n    Range Query -> O(log n +k) -> logn to find the starting range \n    and then traverse horizontally to find the k element horiz as \n    all leaf nodes are connected through linked list . \n\n    \nHash Index -> when we need key value look ups \n\ngood for hash idnex \nSelect * from users where email =\"hrithikdel@gmail.com\"\n\ngood for bt tree bad for hash index \nSelect * from users where email LIKE \"*del@gmail.com\"\n\nHash Index search -> O(1)\n\nFull Text Index -> Postgerois \n    Inverte words-> Documents \n\n\n\n\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "B+ tree Features \n    self balancing tree \n    root and intermediate nodes are just for routing \n    leaves nodes will contain the actual data page \n    all leaf nodes are connected \n    there will m-1 keys \n    Range Queries \nTc - > \n    Insert, search , deletion -> O(log n )\n    Range Query -> O(log n +k) -> logn to find the starting range \n    and then traverse horizontally to find the k element horiz as \n    all leaf nodes are connected through linked list . \n\n    \nHash Index -> when we need key value look ups \n\ngood for hash idnex \nSelect * from users where email =\"hrithikdel@gmail.com\"\n\ngood for bt tree bad for hash index \nSelect * from users where email LIKE \"*del@gmail.com\"\n\nHash Index search -> O(1)\n\nFull Text Index -> Postgerois \n    Inverte words-> Documents \n\n\n\n\n",
			"autoResize": true,
			"lineHeight": 1.25,
