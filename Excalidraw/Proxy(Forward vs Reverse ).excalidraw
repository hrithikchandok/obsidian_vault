      "versionNonce": 912497149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789086623884,
      "link": null,
      "locked": false,
      "text": "Types of Deployment \n1. Blue Green Deployment/Red Black Deployment -> Needed New Infrastructure \n2. Rolling Update -> Once Failed than Roll Back , No Controll \n3. Canary Deployment  -> Controlled Manner , No new Infrastructure \n \n",
      "rawText": "Types of Deployment \n1. Blue Green Deployment/Red Black Deployment -> Needed New Infrastructure \n2. Rolling Update -> Once Failed than Roll Back , No Controll \n3. Canary Deployment  -> Controlled Manner , No new Infrastructure \n \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Types of Deployment \n1. Blue Green Deployment/Red Black Deployment -> Needed New Infrastructure \n2. Rolling Update -> Once Failed than Roll Back , No Controll \n3. Canary Deployment  -> Controlled Manner , No new Infrastructure \n \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "REorJZML",
