      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ForWard Proxy \nReVerse Proxy\nTransparent Proxy \nSideCar Proxy example-> Observilibilty , Metric. Collector  , Logger \n",
      "autoResize": true,
