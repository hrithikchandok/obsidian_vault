      "updated": 1789272286424,
      "link": null,
      "locked": false,
      "text": "SideCar Pattern -> \ncomponent that is deployed with same \nlanguage agnostic \n\nLegacy application \nserving static file \nconfiguration change \nLog aggregator \nMetric Collection\n\n\n",
      "rawText": "SideCar Pattern -> \ncomponent that is deployed with same \nlanguage agnostic \n\nLegacy application \nserving static file \nconfiguration change \nLog aggregator \nMetric Collection\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SideCar Pattern -> \ncomponent that is deployed with same \nlanguage agnostic \n\nLegacy application \nserving static file \nconfiguration change \nLog aggregator \nMetric Collection\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
