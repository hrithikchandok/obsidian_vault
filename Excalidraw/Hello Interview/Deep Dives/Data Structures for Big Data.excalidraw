			"isDeleted": false,
			"boundElements": [],
			"updated": 1739496151210,
			"link": null,
			"locked": false,
			"text": "1) You need to be querying for membership in a set.\n2) You need to be space constrained (otherwise just use a hash table!).\n3) You need to be able to tolerate a false positive rate.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1) You need to be querying for membership in a set.\n2) You need to be space constrained (otherwise just use a hash table!).\n3) You need to be able to tolerate a false positive rate.",
			"autoResize": true,
			"lineHeight": 1.25,
